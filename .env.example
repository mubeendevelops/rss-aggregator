# Copy to .env and adjust. These values match docker-compose.yml.
PORT=8080
DB_URL=postgres://postgres:postgres@localhost:5432/rss-aggregator?sslmode=disable

# The scraper refuses to fetch feeds from loopback, private and link-local
# addresses. Set this to true only to test against a feed server on your own
# machine or network. Leave it unset anywhere the API is reachable by others.
# FEED_ALLOW_PRIVATE_ADDRESSES=true
